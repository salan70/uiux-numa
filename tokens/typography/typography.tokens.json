{
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "LINE Seed JP",
          "Hiragino Sans",
          "Yu Gothic",
          "Meiryo",
          "system-ui",
          "sans-serif"
        ],
        "$description": "日本語プロダクト UI の基本書体。LINE Seed JP を優先し、主要 OS の日本語書体へフォールバックする。"
      }
    },
    "size": {
      "$type": "dimension",
      "sm": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        },
        "$description": "日時や補足など、重要度の低い情報に使う最小サイズ。"
      },
      "md": {
        "$value": {
          "value": 1,
          "unit": "rem"
        },
        "$description": "本文、入力、操作文に使う基準サイズ。"
      },
      "lg": {
        "$value": {
          "value": 1.25,
          "unit": "rem"
        },
        "$description": "セクション見出しに使うサイズ。"
      },
      "xl": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        },
        "$description": "画面ごとに 1 つある主題に使う最大サイズ。"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400,
        "$description": "本文と通常の UI に使うウェイト。"
      },
      "bold": {
        "$value": 700,
        "$description": "見出し、項目名、操作の強調に使うウェイト。"
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.3,
        "$description": "短い見出しのまとまりを保つ行間。"
      },
      "ui": {
        "$value": 1.5,
        "$description": "入力、一覧、操作文で高さと可読性を両立する行間。"
      },
      "body": {
        "$value": 1.75,
        "$description": "複数行の日本語本文を追いやすくする行間。"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "title": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xl}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        },
        "lineHeight": "{font.line-height.tight}"
      },
      "$description": "画面ごとに 1 つある主題。短い文に限り、本文の代わりには使わない。"
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.lg}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        },
        "lineHeight": "{font.line-height.tight}"
      },
      "$description": "画面内の主要セクションを区切る見出し。"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        },
        "lineHeight": "{font.line-height.body}"
      },
      "$description": "説明や案内など、複数行で読む日本語本文。"
    },
    "ui": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        },
        "lineHeight": "{font.line-height.ui}"
      },
      "$description": "入力値、一覧、ナビゲーションなど、通常の UI テキスト。"
    },
    "control": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        },
        "lineHeight": "{font.line-height.ui}"
      },
      "$description": "ボタン、項目名、選択状態など、操作と判断に必要な強調。"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        },
        "lineHeight": "{font.line-height.ui}"
      },
      "$description": "日時や補足など、主要な操作に不要な二次情報。"
    }
  }
}
